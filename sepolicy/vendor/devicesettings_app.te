allow devicesettings_app sysfs_therm:dir search;

# Core Control
allow devicesettings_app vendor_sysfs_corecontrol:dir search;
allow devicesettings_app vendor_sysfs_corecontrol:file { getattr open read write };

allow devicesettings_app sysfs_power_supply:file rw_file_perms;
allow devicesettings_app sysfs_power_supply:dir search;
allow devicesettings_app sysfs_power_supply:file { write setattr };
allow devicesettings_app self:netlink_kobject_uevent_socket { bind create read setopt };
allow devicesettings_app sysfs_power_supply:file { write setattr };
